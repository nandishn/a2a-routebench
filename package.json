{
  "name": "a2a-routebench",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first A2A Agent Card routeability evaluator.",
  "scripts": {
    "backend": "uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
    "frontend": "npm --prefix frontend run dev",
    "agents:up": "python3 scripts/local_agent_cards.py up",
    "agents:down": "python3 scripts/local_agent_cards.py down",
    "build": "npm --prefix frontend run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
